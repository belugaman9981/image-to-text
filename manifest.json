
{
  "manifest_version": 3,
  "name": "Image to Text",
  "version": "1.1.0",
  "description": "Extract text from images using OCR",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],

  "action": {
    "default_title": "Open Image to Text",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  }
}

